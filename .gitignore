# Logs
# Anchored to root so it doesn't also ignore nested source folders named
# "logs" (e.g. src/components/modal/logs/).
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# .env files are committed on purpose — the VITE_ vars are baked into the
# bundle at build time anyway, so they are public the moment the app ships.

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel



